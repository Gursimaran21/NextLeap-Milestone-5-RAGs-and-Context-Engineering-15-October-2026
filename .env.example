# ---- LLM (optional) ----
# If set, src/llm.py will call Gemini for the pulse + fee explainer text.
# If empty, the app uses a deterministic offline writer (still passes all constraints).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ---- MCP / internal tools (optional) ----
# Used only by the real MCP server in mcp/server.py.
# The Streamlit app writes to local files by default (mock Google Doc + Gmail draft).
GOOGLE_DOC_ID=
GMAIL_SENDER=you@example.com

# ---- Approval ----
# "ui"        -> approval via Streamlit button (default, used by app.py)
# "terminal"  -> approval by typing APPROVE at the CLI gate (mcp/approval.py)
APPROVAL_CHANNEL=ui
